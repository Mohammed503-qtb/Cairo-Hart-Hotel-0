# ─────────────────────────────────────────────────────────────
# متغيرات بيئة الإنتاج — منصة فندق قلب القاهرة (عدن) · Task 24-c / P1
#
# ⚠️ هذه نسخة نموذجية فقط. الملف الفعلي للإنتاج هو:
#       /etc/cairo-hart/env
#   بصلاحية 600 ومالك root:deploy — ولا يدخل المستودع أبدًا.
#
# التركيب الأول:
#   sudo mkdir -p /etc/cairo-hart
#   sudo cp deploy/env.production.example /etc/cairo-hart/env
#   sudo nano /etc/cairo-hart/env        # عدّل DOMAIN وافحص البقية
#   sudo chown root:deploy /etc/cairo-hart/env
#   sudo chmod 600 /etc/cairo-hart/env
# ─────────────────────────────────────────────────────────────

# قاعدة بيانات SQLite عبر Prisma — مسار مطلق على خادم الإنتاج
# (المسار النسبي يُحلّ بالنسبة لمجلد prisma/ — استخدم المسار المطلق دائمًا في الإنتاج)
DATABASE_URL=file:/opt/cairo-hart/db/custom.db

# النطاق العام للموقع — تستخدمه Caddy (بوابة 443) وسكربت deploy.sh
# للفحص الصحي بعد كل نشر، وسكربت health-check.sh للمراقبة
DOMAIN=hotel.example.com

# منفذ تطبيق الويب (خادم standalone خلف البوابة — لا يُكشف مباشرة)
PORT=3000

# بيئة التشغيل
NODE_ENV=production

# ── اختياري: تنبيهات المراقبة (راجع docs/MONITORING.md) ──
# Webhook أي قناة يختارها المالك (Discord / Telegram / بريد مُوجّه).
# قناة واتساب للمشغل معلقة بقرار W0 (بلا مزود) — لا تضبطها هنا.
#ALERT_WEBHOOK=https://discord.com/api/webhooks/xxxxx

# ── اختياري: نسخ خارج الموقع عبر rclone (راجع docs/BACKUP_POLICY.md) ──
# اسم remote مضبوط مسبقًا بأمر: rclone config  (مثال: offsite:cairo-hart)
#RCLONE_REMOTE=offsite:cairo-hart
